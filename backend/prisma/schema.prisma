// Prisma Schema for PostgreSQL DoctorFind Healthcare Portal

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Patients {
  id                 String              @id @default(uuid())
  patientId          String              @unique
  name               String
  email              String              @unique
  phone              String
  password           String
  dateOfBirth        DateTime
  gender             String
  bloodGroup         String
  address            String
  city               String?
  state              String?
  pincode            String?
  height             Float?
  weight             Float?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  emergencyContacts  EmergencyContacts[]
  insurance          Insurance[]
  appointments       Appointments[]
  medicalRecords     MedicalRecords[]
  prescriptions      Prescriptions[]
  notifications      Notifications[]
  symptoms           Symptoms[]
  payments           Payments[]
  auditLogs          AuditLogs[]
}

model Doctors {
  id                 String              @id @default(uuid())
  name               String
  email              String              @unique
  phone              String
  specialty          String
  qualification      String
  experienceYears    Int
  rating             Float
  fee                Float
  hospitalId         String?
  hospital           Hospitals?          @relation(fields: [hospitalId], references: [id])
  appointments       Appointments[]
  prescriptions      Prescriptions[]
  createdAt          DateTime            @default(now())
}

model Hospitals {
  id                 String              @id @default(uuid())
  name               String
  address            String
  city               String
  rating             Float
  contactPhone       String
  doctors            Doctors[]
  appointments       Appointments[]
  createdAt          DateTime            @default(now())
}

model Appointments {
  id                 String              @id @default(uuid())
  patientId          String
  patient            Patients            @relation(fields: [patientId], references: [id])
  doctorId           String
  doctor             Doctors             @relation(fields: [doctorId], references: [id])
  hospitalId         String?
  hospital           Hospitals?          @relation(fields: [hospitalId], references: [id])
  date               String
  time               String
  mode               String              // Online, Offline
  status             String              // Confirmed, Pending, Cancelled, Completed
  reason             String?
  videoCallUrl       String?
  createdAt          DateTime            @default(now())
}

model MedicalRecords {
  id                 String              @id @default(uuid())
  patientId          String
  patient            Patients            @relation(fields: [patientId], references: [id])
  title              String
  category           String
  fileUrl            String
  fileType           String
  dateUploaded       DateTime            @default(now())
  notes              String?
}

model Prescriptions {
  id                 String              @id @default(uuid())
  patientId          String
  patient            Patients            @relation(fields: [patientId], references: [id])
  doctorId           String
  doctor             Doctors             @relation(fields: [doctorId], references: [id])
  date               String
  status             String              // Current, Expired, Completed
  medicines          Medicines[]
  pdfUrl             String?
  createdAt          DateTime            @default(now())
}

model Medicines {
  id                 String              @id @default(uuid())
  prescriptionId     String
  prescription       Prescriptions       @relation(fields: [prescriptionId], references: [id])
  name               String
  dosage             String
  frequency          String
  duration           String
  instructions       String?
}

model Notifications {
  id                 String              @id @default(uuid())
  patientId          String
  patient            Patients            @relation(fields: [patientId], references: [id])
  title              String
  message            String
  type               String              // appointment, medicine, message, report
  isRead             Boolean             @default(false)
  createdAt          DateTime            @default(now())
}

model Symptoms {
  id                 String              @id @default(uuid())
  patientId          String
  patient            Patients            @relation(fields: [patientId], references: [id])
  symptomsText       String
  severity           String
  suggestedSpecialist String
  recommendations    String
  createdAt          DateTime            @default(now())
}

model Payments {
  id                 String              @id @default(uuid())
  patientId          String
  patient            Patients            @relation(fields: [patientId], references: [id])
  amount             Float
  currency           String              @default("INR")
  status             String
  paymentMethod      String
  createdAt          DateTime            @default(now())
}

model Insurance {
  id                 String              @id @default(uuid())
  patientId          String
  patient            Patients            @relation(fields: [patientId], references: [id])
  provider           String
  policyNumber       String
  coverage           String
  expiry             String
}

model EmergencyContacts {
  id                 String              @id @default(uuid())
  patientId          String
  patient            Patients            @relation(fields: [patientId], references: [id])
  name               String
  relationship       String
  phone              String
}

model AuditLogs {
  id                 String              @id @default(uuid())
  patientId          String?
  patient            Patients?           @relation(fields: [patientId], references: [id])
  action             String
  details            String
  ipAddress          String?
  createdAt          DateTime            @default(now())
}
